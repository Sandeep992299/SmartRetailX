meta {
  name: Create Order
  type: http
  seq: 1
}

post {
  url: {{GATEWAY_URL}}/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "items": [
      {
        "product_id": "1",
        "product_name": "Wireless Noise-Canceling Headphones",
        "price": 199.99,
        "quantity": 1
      }
    ]
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.status: eq Pending
}
