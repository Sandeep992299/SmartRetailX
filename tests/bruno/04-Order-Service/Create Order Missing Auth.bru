meta {
  name: Create Order Missing Auth
  type: http
  seq: 2
}

post {
  url: {{GATEWAY_URL}}/orders
  body: json
  auth: none
}

body:json {
  {
    "items": [
      {
        "product_id": "1",
        "product_name": "Wireless Noise-Canceling Headphones",
        "price": 199.99,
        "quantity": 1
      }
    ]
  }
}

assert {
  res.status: eq 401
}
